{
  "name": "tmx-local-workbench",
  "productName": "TMX Local Workbench",
  "version": "0.2.1",
  "private": true,
  "main": "dist-desktop/desktop/main.js",
  "scripts": {
    "dev": "pnpm desktop:dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:node": "pnpm rebuild better-sqlite3",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "native:electron:win": "pnpm --config.platform=win32 --config.arch=x64 --config.runtime=electron --config.target=42.7.0 rebuild better-sqlite3",
    "desktop:build": "node -e \"require('node:fs').rmSync('dist-desktop',{recursive:true,force:true})\" && tsc -p tsconfig.desktop.json",
    "desktop:dev": "pnpm build && pnpm desktop:build && pnpm native:electron && electron .",
    "desktop:package": "pnpm build && pnpm desktop:build && electron-forge package",
    "desktop:make": "pnpm build && pnpm desktop:build && electron-forge make",
    "desktop:make:win": "pnpm build && pnpm desktop:build && pnpm native:electron:win && electron-forge make --platform win32 --arch x64"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.11",
    "@ai-sdk/react": "^4.0.30",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.28",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react-resizable-panels": "^4.12.2",
    "saxes": "^6.0.0",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@next/eslint-plugin-next": "15.5.20",
    "@tanstack/react-virtual": "^3.13.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "electron": "^42.7.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.4.1",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ]
  }
}
